PLANE_API_KEY=your-plane-api-key
PLANE_WORKSPACE_SLUG=your-plane-workspace-slug
PLANE_PROJECT_ID=your-plane-project-id
PROJECT_REPO_URL=git@github.com:your-org/your-repo.git
SYMPHONY_WORKSPACE_ROOT=/absolute/path/on-the-worker-for-symphony-workspaces

# Optional for self-hosted Plane.
# SYMPHONY_LIVE_PLANE_ENDPOINT=https://plane.example.com

# Optional to use real SSH workers instead of the disposable docker-compose workers.
# SYMPHONY_LIVE_SSH_WORKER_HOSTS=host1,host2

# Optional assignee filter for normal Plane workflows.
# PLANE_ASSIGNEE=your-plane-user-id

# Recommended for unattended PR creation on SSH workers. If unset,
# docker/run-symphony-plane-host-worker.sh will try `gh auth token`
# on the host and export that value as `GH_TOKEN`.
# GH_TOKEN=gho_xxx
# GITHUB_TOKEN=gho_xxx

# Optional overrides for the Docker-to-host SSH worker helper.
# SYMPHONY_SSH_KEY_PATH=/absolute/path/to/private/key
# SYMPHONY_SSH_CONFIG_PATH=/absolute/path/to/ssh_config.local
